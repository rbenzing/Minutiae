# Pinned toolchain for the recovery fixtures of sub-project 3 (see README.md,
# "Recovery fixtures: toolchain probe"). Separate from the other fixture images
# so their pinned layers (and every existing fixture) stay byte-identical.
#
# Base: debian:bookworm-slim, pinned by the index digest Dockerfile.hfs pins.
FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251

# apt reads the archive as it was on SNAPSHOT (snapshot.debian.org) and every
# package is pinned to the exact version, so a rebuild installs the same bytes
# or fails loudly. Snapshot Release files expire, hence Check-Valid-Until=false.
ARG SNAPSHOT=20261003T000000Z
RUN printf '%s\n' \
      'Types: deb' \
      "URIs: http://snapshot.debian.org/archive/debian/${SNAPSHOT}/" \
      'Suites: bookworm bookworm-updates' \
      'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
      '' \
      'Types: deb' \
      "URIs: http://snapshot.debian.org/archive/debian-security/${SNAPSHOT}/" \
      'Suites: bookworm-security' \
      'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
      > /etc/apt/sources.list.d/debian.sources \
 && printf 'Acquire::Check-Valid-Until "false";\nAcquire::Retries "5";\n' > /etc/apt/apt.conf.d/99snapshot \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      qemu-system-x86=1:7.2+dfsg-7+deb12u18+b3 \
      linux-image-amd64=6.1.187-1 \
      linux-image-6.1.0-53-amd64=6.1.187-1 \
      busybox-static=1:1.35.0-4+deb12u1+b1 \
      e2fsprogs=1.47.0-2+b2 \
      f2fs-tools=1.15.0-1 \
      exfatprogs=1.2.0-1+deb12u1 \
      exfat-fuse=1.3.0+git20220115-2 \
      dosfstools=4.2-1 \
      mtools=4.0.33-1+really4.0.32-1 \
      sqlite3=3.40.1-2+deb12u2 \
      faketime=0.9.10-2.1 \
      python3=3.11.2-1+b1 \
      jq=1.6-2.1+deb12u2 \
      gzip=1.12-1 \
      kmod=30+20221128-1 \
      cpio=2.13+dfsg-7.1 \
 && rm -rf /var/lib/apt/lists/*

ENV SOURCE_DATE_EPOCH=1700000000 \
    TZ=UTC \
    LC_ALL=C
